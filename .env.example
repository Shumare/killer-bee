# Copier ce fichier en .env et remplir les valeurs

# Secret JWT (utiliser une valeur longue et aléatoire en production)
JWT_SECRET=change-me-in-production

# Fuseau horaire des containers (affiché dans les logs applicatifs)
# Exemples : UTC, Europe/Paris, America/New_York
TZ=UTC

# ── Synchronisation NTP ───────────────────────────────────────────────────────
# Les containers partagent l'horloge du daemon Docker host.
# Configurer chrony ou ntpd sur l'hôte pour pointer vers le serveur NTP interne.
#
# Exemple /etc/chrony.conf (Linux) :
#   server <NTP_SERVER_ADDRESS> iburst prefer
#
# Remplacer <NTP_SERVER_ADDRESS> par l'IP ou hostname de ton serveur NTP.
NTP_SERVER=
