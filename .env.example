# Copier ce fichier en .env et remplir les valeurs

# Mot de passe SQL Server (compte sa)
# Politique de complexité obligatoire : ≥8 caractères, majuscule, minuscule, chiffre, caractère spécial
SA_PASSWORD=

# Secret JWT (utiliser une valeur longue et aléatoire en production)
JWT_SECRET=change-me-in-production

# Clé de chiffrement applicatif — partagée par tous les services et le frontend
# Doit être identique dans CIPHER_KEY (backend) et VITE_CIPHER_KEY (frontend)
# Utiliser uniquement des caractères ASCII. Longueur recommandée : 16 à 32 caractères.
CIPHER_KEY=
VITE_CIPHER_KEY=
