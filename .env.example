# Copier ce fichier en .env et remplir les valeurs

# Secret JWT (utiliser une valeur longue et aléatoire en production)
JWT_SECRET=change-me-in-production

# Mot de passe SQL Server SA (min 8 chars, majuscule + minuscule + chiffre + spécial)
# Utilisé aussi comme DB_PASSWORD par les microservices
SA_PASSWORD=KillerBee_2024!
